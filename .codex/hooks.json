{
  "description": "Project-local writing-th v7 Codex hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$|^Edit$|^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/skills/writing-th/scripts/check_draft_preconditions.mjs",
            "commandWindows": "node .agents\\skills\\writing-th\\scripts\\check_draft_preconditions.mjs",
            "timeout": 15,
            "statusMessage": "Checking writing-th blueprint gate & ledger guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$|^Edit$|^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/skills/writing-th/scripts/post_draft_lint.mjs",
            "commandWindows": "node .agents\\skills\\writing-th\\scripts\\post_draft_lint.mjs",
            "timeout": 30,
            "statusMessage": "Linting Thai draft"
          }
        ]
      }
    ]
  }
}
