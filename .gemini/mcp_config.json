{
  "mcpServers": {
    "oracle-v2": {
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "oracle-arun-creagy",
        "bun",
        "src/index.ts"
      ],
      "cwd": "C:/Users/sitth/OracleWorkspace/engine",
      "description": "Local Oracle Registry (Registry of Form)"
    },
    "perplexity": {
      "command": "cmd",
      "args": [
        "/c",
        "set \"PERPLEXITY_API_KEY=%PERPLEXITY_API_KEY%\" && npx -y @perplexity-ai/mcp-server"
      ],
      "description": "AI web search"
    },
    "brave-search": {
      "command": "cmd",
      "args": [
        "/c",
        "set \"BRAVE_API_KEY=%BRAVE_API_KEY%\" && npx -y @modelcontextprotocol/server-brave-search"
      ],
      "description": "web search"
    }
  }
}
