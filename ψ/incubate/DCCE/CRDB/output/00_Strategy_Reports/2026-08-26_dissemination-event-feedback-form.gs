/**
 * CRDB — แบบสอบถามความคิดเห็นผู้เข้าร่วม
 * การประชุมเผยแพร่ผลการศึกษา (Final Dissemination Event) — 26 สิงหาคม 2569
 *
 * โครงการพัฒนาชุดข้อมูล องค์ความรู้ ความเสี่ยง และผลกระทบ
 * จากการเปลี่ยนแปลงสภาพภูมิอากาศของประเทศไทย (กรม สส. / DCCE)
 *
 * ────────────────────────────────────────────────────────────────
 * วิธีใช้ — สร้างฟอร์มครั้งแรก (FIRST RUN)
 * ────────────────────────────────────────────────────────────────
 * 1. เปิด https://script.google.com  →  New project
 * 2. ลบโค้ดตัวอย่างทั้งหมด แล้ววางไฟล์นี้แทน
 * 3. เลือกฟังก์ชัน `createCrdbFeedbackForm` จากเมนู dropdown ด้านบน
 * 4. กด Run  →  อนุญาตสิทธิ์ (Review permissions → Allow) ครั้งแรกครั้งเดียว
 * 5. ดู Execution log (View → Logs หรือ Ctrl+Enter) — จะพิมพ์ลิงก์และ FORM ID
 * 6. คัดลอกค่า FORM ID จาก log มาใส่ในตัวแปร FORM_ID ด้านล่างนี้ แล้วบันทึกไฟล์ไว้
 *    (จำเป็นสำหรับการอัปเดตฟอร์มในครั้งถัดไป โดยไม่ต้องสร้างฟอร์มใหม่)
 *
 * ────────────────────────────────────────────────────────────────
 * วิธีใช้ — แก้ไขคำถามแล้วอัปเดตฟอร์มเดิม (UPDATE AN EXISTING FORM)
 * ────────────────────────────────────────────────────────────────
 * ใช้เมื่อฟอร์มถูกสร้างและเผยแพร่ (LIVE URL) ไปแล้ว และมีการแก้ไขคำถามในไฟล์นี้
 * ภายหลัง — การรัน createCrdbFeedbackForm() ซ้ำจะสร้างฟอร์มใหม่อีกชุดหนึ่ง
 * (คนละลิงก์ คนละ Sheet) จึงต้องใช้ updateCrdbFeedbackForm() แทน:
 * 1. ตรวจสอบว่าตัวแปร FORM_ID ด้านล่างมีค่าแล้ว (มาจากขั้นตอน FIRST RUN ข้อ 6)
 *    หากยังไม่มี ให้เปิด EDIT URL ของฟอร์ม แล้วคัดลอกส่วน ID จาก URL รูปแบบ
 *    https://docs.google.com/forms/d/{FORM_ID}/edit
 * 2. วางโค้ดฉบับแก้ไขล่าสุดทั้งไฟล์ทับของเดิมใน script.google.com (Ctrl+A แล้ววาง)
 * 3. เลือกฟังก์ชัน `updateCrdbFeedbackForm` จากเมนู dropdown ด้านบน แล้วกด Run
 * 4. ฟังก์ชันนี้จะลบคำถามเดิมทั้งหมดแล้วสร้างใหม่ตามโค้ดปัจจุบัน — LIVE URL,
 *    SHORT URL และ Google Sheet ที่เชื่อมรับคำตอบเดิมจะยังคงเดิมทุกอย่าง
 *    (คำตอบที่มีคนตอบไปแล้วใน Sheet จะไม่หายไป แต่คำถามที่ถูกลบจะไม่มีคอลัมน์
 *    คำตอบใหม่เพิ่มเข้ามาให้ย้อนหลัง)
 *
 * ────────────────────────────────────────────────────────────────
 * โครงสร้างฟอร์ม
 * ────────────────────────────────────────────────────────────────
 * โครงสร้าง: 4 ส่วน / 20 คำถาม (รวม 34 รายการย่อยใน Grid ระดับ node)
 * ออกแบบให้ตอบไปพร้อมกับการนำเสนอ โดยสมดุลระหว่างพลังงานสมองของผู้ตอบกับความ
 * ละเอียดที่โครงการต้องการ: แทนที่จะแยกหน้าฟอร์มทีละหัวข้อย่อย (node) ซึ่งจะขัดจังหวะ
 * การนำเสนอถึง ~18-20 ครั้ง ใช้ Grid แตะให้คะแนน 1-5 ต่อ node รวมกันในหน้าเดียวต่อบท
 * แทน — จำนวนครั้งที่หยุดพักเท่าเดิม (4 หน้า) แต่ได้ข้อมูลระดับ node ครบทุกหัวข้อ
 *
 * สำหรับ node โครงสร้างเว็บแพลตฟอร์ม (13 node) วัด 2 มิติแยกกัน แทนที่จะถามแค่
 * "เกี่ยวข้องกับงานท่านหรือไม่" ซึ่งมักได้คะแนนสูงเกือบทุก node เพราะผู้เข้าร่วม
 * ถูกคัดมาแล้วว่าเกี่ยวข้อง ทำให้แยกแยะไม่ได้ (ceiling effect):
 *   • Build Priority   — ควรพัฒนา/มีให้ใช้ก่อนเรื่องอื่นแค่ไหน (สะท้อนความต้องการ)
 *   • Completeness     — เนื้อหาที่นำเสนอวันนี้ครบถ้วนแค่ไหนในมุมมองผู้ใช้จริง
 * อ่านคู่กัน priority สูง + completeness ต่ำ = node ที่ต้องเร่งเติมเนื้อหาก่อนเป็นลำดับแรก
 *
 *   ส่วนที่ 1  ข้อมูลผู้ตอบ                              (ก่อนเริ่มนำเสนอ)
 *   ส่วนที่ 2  โครงสร้างเว็บแพลตฟอร์มและบริการสารสนเทศ   (หลัง Slide 36)
 *              — Priority + Completeness grid ต่อ node ทั้ง 13 node
 *                (ภาพรวมประเทศ 4, ศูนย์ข้อมูลนโยบาย 4, วงจรการปรับตัว 5)
 *              — Priority grid ต่อ 8 บริการสารสนเทศหลัก
 *   ส่วนที่ 3  บัญชีข้อมูล การแบ่งปันข้อมูล และธรรมาภิบาล (หลัง Slide 41)
 *   ส่วนที่ 4  ความพึงพอใจต่อการประชุม                   (ปิดท้าย)
 */

// ตั้งค่าหลังรัน createCrdbFeedbackForm() ครั้งแรก แล้วนำ FORM_ID จาก log มาใส่ที่นี่
// เพื่อให้ updateCrdbFeedbackForm() รู้ว่าจะแก้ไขฟอร์มไหน
var FORM_ID = '';

/**
 * รันครั้งแรกเท่านั้น — สร้างฟอร์มใหม่ + Google Sheet ใหม่สำหรับรับคำตอบ
 */
function createCrdbFeedbackForm() {
  var form = FormApp.create(
    'แบบสอบถามความคิดเห็น — การประชุมเผยแพร่ผลการศึกษา (26 สิงหาคม 2569)'
  );

  var ss = SpreadsheetApp.create(
    '[Responses] แบบสอบถามความคิดเห็น — การประชุมเผยแพร่ผลการศึกษา 26 ส.ค. 2569'
  );
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());

  buildFormBody(form);
  logFormLinks(form, ss.getUrl(), /* isUpdate */ false);
}

/**
 * รันซ้ำได้ทุกครั้งที่แก้ไขคำถามในไฟล์นี้ — ต้องตั้งค่า FORM_ID ด้านบนก่อน
 * ลบคำถามเดิมทั้งหมดแล้วสร้างใหม่ตามโค้ดปัจจุบัน โดย URL และ Sheet ที่เชื่อมไว้
 * จะยังเป็นอันเดิม
 */
function updateCrdbFeedbackForm() {
  if (!FORM_ID) {
    throw new Error(
      'ยังไม่ได้ตั้งค่า FORM_ID — เปิด EDIT URL ของฟอร์ม คัดลอก ID จาก URL ' +
      '(https://docs.google.com/forms/d/{FORM_ID}/edit) มาใส่ในตัวแปร FORM_ID ' +
      'ที่ด้านบนของไฟล์นี้ก่อน'
    );
  }

  var form = FormApp.openById(FORM_ID);

  // ลบคำถาม/หัวข้อเดิมทั้งหมด (คำตอบเก่าใน Sheet ที่เชื่อมไว้จะไม่ถูกลบ)
  var items = form.getItems();
  for (var i = items.length - 1; i >= 0; i--) {
    form.deleteItem(items[i]);
  }

  buildFormBody(form);

  var destId = form.getDestinationId();
  var responsesUrl = destId
    ? SpreadsheetApp.openById(destId).getUrl()
    : '(ยังไม่ได้เชื่อม Google Sheet)';

  logFormLinks(form, responsesUrl, /* isUpdate */ true);
}

/**
 * สร้างเนื้อหาฟอร์มทั้งหมด (metadata + ทุกคำถาม) — ใช้ร่วมกันทั้งตอนสร้างใหม่
 * และตอนอัปเดต เพื่อไม่ให้โครงสร้างคำถามเพี้ยนระหว่างสองโหมด
 */
function buildFormBody(form) {
  form.setTitle('แบบสอบถามความคิดเห็นผู้เข้าร่วมการประชุมเผยแพร่ผลการศึกษา');

  form.setDescription(
    'โครงการพัฒนาชุดข้อมูล องค์ความรู้ ความเสี่ยง และผลกระทบ' +
    'จากการเปลี่ยนแปลงสภาพภูมิอากาศของประเทศไทย\n' +
    'กรมการเปลี่ยนแปลงสภาพภูมิอากาศและสิ่งแวดล้อม (กรม สส.)\n' +
    'วันที่ 26 สิงหาคม 2569\n\n' +
    'แบบสอบถามนี้ออกแบบให้ท่านตอบไปพร้อมกับการนำเสนอได้ ' +
    'โดยแบ่งเป็น 4 ส่วนตามลำดับหัวข้อที่นำเสนอ ' +
    'ใช้เวลาประมาณ 5–7 นาที\n\n' +
    'ความคิดเห็นของท่านจะถูกนำไปใช้ประกอบการจัดทำข้อเสนอเชิงนโยบาย ' +
    'และการส่งมอบข้อกำหนดการพัฒนาแพลตฟอร์มในระยะต่อไป ' +
    'คำตอบจะถูกวิเคราะห์ในภาพรวมโดยไม่ระบุตัวบุคคล'
  );

  form.setProgressBar(true);
  form.setCollectEmail(false);
  form.setAllowResponseEdits(true);
  form.setShuffleQuestions(false);
  form.setConfirmationMessage(
    'ขอขอบคุณสำหรับความคิดเห็นของท่าน\n' +
    'ข้อเสนอแนะของท่านจะถูกนำไปใช้ในการพัฒนาแพลตฟอร์มข้อมูล' +
    'การปรับตัวต่อการเปลี่ยนแปลงสภาพภูมิอากาศของประเทศไทย'
  );

  // ผู้เข้าร่วมส่วนใหญ่เป็นบุคคลภายนอก — ไม่บังคับ sign-in
  // (มีผลเฉพาะบัญชี Google Workspace; บัญชีทั่วไปจะข้ามไป)
  try {
    form.setRequireLogin(false);
  } catch (e) {
    Logger.log('setRequireLogin ไม่รองรับในบัญชีนี้ — ข้ามได้ตามปกติ');
  }

  /* ══════════════════════════════════════════════════════════════
   * ส่วนที่ 1 — ข้อมูลผู้ตอบ
   * ══════════════════════════════════════════════════════════════ */

  form.addSectionHeaderItem()
    .setTitle('ส่วนที่ 1 — ข้อมูลผู้ตอบ')
    .setHelpText('กรุณากรอกก่อนเริ่มการนำเสนอ');

  // Q1
  form.addTextItem()
    .setTitle('หน่วยงาน / สังกัด')
    .setHelpText('เช่น กรมอุตุนิยมวิทยา, สำนักงบประมาณ, มหาวิทยาลัย... (ระบุกอง/สำนักได้หากสะดวก)')
    .setRequired(true);

  // Q2
  form.addMultipleChoiceItem()
    .setTitle('กลุ่มผู้ตอบ')
    .setChoiceValues([
      'เจ้าหน้าที่กรมการเปลี่ยนแปลงสภาพภูมิอากาศและสิ่งแวดล้อม (กรม สส.)',
      'เจ้าหน้าที่หน่วยงานรัฐรายสาขาที่เกี่ยวข้องกับแผนการปรับตัวฯ (NAP)',
      'หน่วยงานด้านงบประมาณ แผน และการพัฒนาบริการสารสนเทศ',
      'นักวิชาการ / นักวิจัย / ผู้เชี่ยวชาญด้านภูมิอากาศ',
      'องค์กรปกครองส่วนท้องถิ่น / หน่วยงานระดับพื้นที่',
      'ภาคเอกชน',
      'สถาบันการเงิน',
      'ภาคประชาสังคม',
      'องค์กรระหว่างประเทศ'
    ])
    .showOtherOption(true)
    .setRequired(true);

  // Q3
  var q3 = form.addCheckboxItem()
    .setTitle('บทบาทของท่านที่เกี่ยวข้องกับข้อมูล (เลือกได้มากกว่า 1 ข้อ)')
    .setChoiceValues([
      'ผู้ผลิต / เจ้าของชุดข้อมูล',
      'ผู้ใช้ข้อมูลเพื่อการตัดสินใจหรือการปฏิบัติงาน',
      'นักวิเคราะห์ / นักวิชาการที่ประมวลผลข้อมูล',
      'ผู้กำหนดนโยบายหรือจัดทำแผน',
      'ผู้ดูแลระบบข้อมูลหรือระบบสารสนเทศ (IT)'
    ])
    .showOtherOption(true);
  q3.setRequired(true);

  /* ══════════════════════════════════════════════════════════════
   * ส่วนที่ 2 — โครงสร้างเว็บแพลตฟอร์มและบริการสารสนเทศ
   * (ตอบหลังการนำเสนอ Slide 16–36)
   * ══════════════════════════════════════════════════════════════ */

  form.addPageBreakItem()
    .setTitle('ส่วนที่ 2 — โครงสร้างเว็บแพลตฟอร์มและบริการสารสนเทศ')
    .setHelpText(
      'อ้างอิงหัวข้อ "โครงสร้างเว็บแพลตฟอร์มการปรับตัวต่อการเปลี่ยนแปลงสภาพภูมิอากาศ" ' +
      'และ "รายการความต้องการบริการด้านข้อมูลสารสนเทศภูมิอากาศ"'
    );

  // ระดับ 1–5 ใช้ซ้ำในทุก Grid ของหัวข้อนี้
  // priority     = ความต้องการของผู้ใช้ (ควรพัฒนา/มีให้ใช้ก่อนเรื่องอื่นแค่ไหน)
  // completeness = มุมมองของผู้ใช้ต่อความครบถ้วนของเนื้อหาที่นำเสนอในวันนี้
  // อ่านคู่กัน: priority สูง + completeness ต่ำ = จุดที่ต้องเร่งเติมเนื้อหาก่อนเป็นลำดับแรก
  var priorityCols = [
    '1 ไม่เร่งด่วน',
    '2',
    '3 ปานกลาง',
    '4',
    '5 ควรพัฒนา/มีให้ใช้ก่อน'
  ];
  var completenessCols = [
    '1 ยังไม่ครบถ้วน',
    '2',
    '3 ปานกลาง',
    '4',
    '5 ครบถ้วน พร้อมใช้งานจริง'
  ];

  // Q4 — Grid: Build Priority — ภาพรวมระดับประเทศ (Slide 19–22)
  form.addGridItem()
    .setTitle('ความสำคัญที่ควรพัฒนาก่อน (ตามความต้องการของหน่วยงานท่าน) — ภาพรวมระดับประเทศ')
    .setHelpText('1 = ไม่เร่งด่วน, 5 = ควรพัฒนา/มีให้ใช้ก่อนเป็นลำดับแรก')
    .setRows([
      'หน้าแรก (Homepage)',
      '1. ภาพรวมระดับประเทศ (Country\'s Overview)',
      '1.1 ภาพรวมความเสี่ยงจากสภาพภูมิอากาศของไทย',
      '1.2 ความเสี่ยงสำคัญและทิศทางการปรับตัว'
    ])
    .setColumns(priorityCols)
    .setRequired(true);

  // Q5 — Grid: Completeness — ภาพรวมระดับประเทศ
  form.addGridItem()
    .setTitle('ความครบถ้วนของเนื้อหาที่นำเสนอ ในมุมมองของท่าน — ภาพรวมระดับประเทศ')
    .setHelpText('1 = ยังไม่ครบถ้วน ขาดหลายส่วน, 5 = ครบถ้วน พร้อมใช้งานจริง')
    .setRows([
      'หน้าแรก (Homepage)',
      '1. ภาพรวมระดับประเทศ (Country\'s Overview)',
      '1.1 ภาพรวมความเสี่ยงจากสภาพภูมิอากาศของไทย',
      '1.2 ความเสี่ยงสำคัญและทิศทางการปรับตัว'
    ])
    .setColumns(completenessCols)
    .setRequired(true);

  // Q6 — Grid: Build Priority — ศูนย์ข้อมูลสำหรับผู้กำหนดนโยบายและแผน (Slide 23–26)
  form.addGridItem()
    .setTitle('ความสำคัญที่ควรพัฒนาก่อน — ศูนย์ข้อมูลสำหรับผู้กำหนดนโยบายและแผน')
    .setHelpText('1 = ไม่เร่งด่วน, 5 = ควรพัฒนา/มีให้ใช้ก่อนเป็นลำดับแรก')
    .setRows([
      '2. ศูนย์ข้อมูลสำหรับผู้กำหนดนโยบายและแผน',
      '2.1 สถานการณ์การเปลี่ยนแปลงสภาพภูมิอากาศของประเทศ',
      '2.2 โปรไฟล์ความเสี่ยงรายพื้นที่และรายสาขา',
