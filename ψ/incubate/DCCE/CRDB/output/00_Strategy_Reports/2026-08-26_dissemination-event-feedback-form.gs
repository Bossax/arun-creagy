/**
 * พิมพ์ลิงก์และ ID ของฟอร์มไปที่ Execution log
 */
function logFormLinks(form, responsesUrl, isUpdate) {
  var live = form.getPublishedUrl();
  var shortUrl = '';
  try {
    shortUrl = form.shortenFormUrl(live);
  } catch (e) {
    shortUrl = '(ไม่สามารถย่อลิงก์ได้)';
  }

  Logger.log('════════════════════════════════════════════');
  Logger.log(isUpdate ? 'อัปเดตแบบสอบถามสำเร็จ' : 'สร้างแบบสอบถามสำเร็จ');
  Logger.log('════════════════════════════════════════════');
  Logger.log('FORM ID       : ' + form.getId());
  Logger.log('LIVE URL      : ' + live);
  Logger.log('SHORT URL     : ' + shortUrl);
  Logger.log('EDIT URL      : ' + form.getEditUrl());
  Logger.log('RESPONSES     : ' + responsesUrl);
  Logger.log('════════════════════════════════════════════');
  if (!isUpdate) {
    Logger.log('ขั้นตอนถัดไป: คัดลอก FORM ID ด้านบนไปใส่ในตัวแปร FORM_ID ที่หัวไฟล์นี้ ' +
      'เพื่อให้แก้ไขคำถามในอนาคตได้ผ่าน updateCrdbFeedbackForm() โดยไม่สร้างฟอร์มใหม่');
  }
  Logger.log('นำ SHORT URL ไปสร้าง QR code สำหรับสไลด์เปิดการประชุม');
}
