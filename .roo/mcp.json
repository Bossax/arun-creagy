{
	"mcpServers": {
		"oracle-v2": {
			"command": "docker",
			"args": [
				"exec",
				"-i",
				"oracle-arun-creagy",
				"bun",
				"src/index.ts"
			],
			"cwd": "C:/Users/sitth/OracleWorkspace/engine",
			"description": "Local Oracle Registry (Registry of Form)",
			"alwaysAllow": [
				"arra_threads",
				"arra_search",
				"arra_trace",
				"arra_handoff",
				"arra_learn",
				"oracle_search",
				"oracle_trace",
				"oracle_learn"
			]
		},
		"notebooklm-mcp": {
			"type": "stdio",
			"command": "notebooklm-mcp",
			"description": "NotebookLM MCP server (API-based, low-latency)",
			"disabled": false,
			"alwaysAllow": [
				"notebook_list",
				"notebook_get",
				"notebook_query",
				"server_info"
			]
		},
		"perplexity": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@perplexity-ai/mcp-server"
			],
			"env": {
				"PERPLEXITY_API_KEY": "${env:PERPLEXITY_API_KEY}"
			},
			"description": "AI web search",
			"alwaysAllow": []
		},
		"brave-search": {
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-brave-search"
			],
			"env": {
				"BRAVE_API_KEY": "${env:BRAVE_API_KEY}"
			},
			"description": "web search",
			"alwaysAllow": [
				"brave_web_search"
			]
		}
	}
}